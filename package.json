{
  "name": "makerspace-react",
  "version": "0.1.1",
  "license": "MIT",
  "description": "React UI for the makerspace interface",
  "resolutions": {
    "fast-uri": "^3.1.6",
    "postcss": "^8.5.23",
    "js-yaml": "^3.15.1",
    "browserslist": "^4.28.7"
  },
  "main": "index.js",
  "dependencies": {
    "@capacitor/android": "8",
    "@capacitor/app": "8",
    "@capacitor/browser": "8",
    "@capacitor/core": "8",
    "@capacitor/ios": "8",
    "@emotion/react": "^11.0.0",
    "@emotion/styled": "^11.0.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@redux-devtools/extension": "^4.0.0",
    "awesome-debounce-promise": "^2.1.0",
    "axios": "^1.20.0",
    "braintree-web": "^3.145.0",
    "firebase": "^12.19.0",
    "leaflet": "^1.9.4",
    "lodash-es": "^4.17.21",
    "makerspace-ts-api-client": "2.9.0",
    "moment-timezone": "^0.6.4",
    "prop-types": "^15.8.1",
    "qr-scanner": "1.4.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^6.30.6",
    "react-select": "^5.10.2",
    "react-signature-canvas": "^1.0.7",
    "recharts": "^2.15.4",
    "redux": "^5.0.1",
    "redux-thunk": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@babel/plugin-transform-typescript": "^8.0.6",
    "@babel/preset-env": "^8.0.6",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@capacitor/cli": "8.5.2",
    "@playwright/test": "^1.63.0",
    "@types/braintree-web": "^3.143.0",
    "@types/jest": "^30.0.0",
    "@types/leaflet": "^1.9.12",
    "@types/lodash-es": "^4.17.1",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-loader": "^10.1.1",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "html-loader": "^5.0.0",
    "html-webpack-plugin": "^5.6.8",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "mini-css-extract-plugin": "^2.0.0",
    "plist": "3.1.1",
    "redux-mock-store": "^1.5.3",
    "sass": "^1.105.0",
    "sass-loader": "^17.0.1",
    "simple-git": "^3.5.0",
    "ts-jest": "^29.4.13",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.0.0",
    "tslib": "^2.8.1",
    "typescript": "^6.0.0",
    "webpack": "^5.111.1",
    "webpack-bundle-analyzer": "^5.4.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0",
    "xcode": "3.0.1"
  },
  "scripts": {
    "clean": "rm -fr ./node_modules ./dist",
    "start": "webpack serve --config dev.config.js",
    "open": "yarn start --open",
    "build": "cross-env NODE_ENV=production webpack --config prod.config.js && node scripts/build_rails_manifest.js",
    "test": "jest --no-cache",
    "test-watch": "yarn test --watch",
    "typecheck": "tsc --noEmit -p tsconfig.test.json --ignoreDeprecations 6.0",
    "build:native": "cross-env NODE_ENV=production webpack --config native.config.js",
    "android:sync": "yarn build:native && cap sync android",
    "android:open": "cap open android",
    "android:debug": "node scripts/android-build.js assembleDebug",
    "android:release": "node scripts/android-build.js bundleRelease",
    "ios:add": "cap add ios && node scripts/configure-ios.js",
    "ios:sync": "yarn build:native && node scripts/configure-ios.js && cap sync ios",
    "ios:open": "cap open ios"
  },
  "jest": {
    "collectCoverage": false,
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}"
    ],
    "coverageReporters": [
      "text",
      "html"
    ],
    "transform": {
      "^.+\\.(j|t)sx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "testRegex": "/tests/unit/.*\\.spec\\.(j|t)sx?$",
    "transformIgnorePatterns": [
      "/node_modules/(?!lodash-es)"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/tests/unit/styleStub.js",
      "^(api|app|ui|documents|components|pages|hooks)[/](.*)$": "<rootDir>/src/$1/$2",
      "^(nfc|native)[/](.*)$": "<rootDir>/src/$1/$2"
    },
    "moduleFileExtensions": [
      "js",
      "ts",
      "tsx"
    ],
    "testEnvironment": "jsdom",
    "testEnvironmentOptions": {}
  }
}
