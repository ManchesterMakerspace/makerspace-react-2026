    "@capacitor/app-launcher": "8.0.1",
    "@capacitor/barcode-scanner": "3.1.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/share": "8.0.2",
    "@capacitor/network": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor-firebase/authentication": "8.5.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2"
  }
