{
  "name": "mms-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "sync": "node scripts/sync.cjs",
    "open": "cap open android",
